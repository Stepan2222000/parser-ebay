# Воркер-сервер (удалённый, напр. 2.27.20.221) — DSN по IP. Воркеру нужны только
# PARSER_DSN и EBAY_DATA_DSN; EBAY_FILTERING_DSN — кэш/фильтрация (по наличию).
PARSER_DSN=postgresql://admin:PASSWORD@194.164.245.107:5420/parser_ebay
EBAY_DATA_DSN=postgresql://admin:PASSWORD@194.164.245.107:5415/ebay_data
EBAY_FILTERING_DSN=postgresql://admin:PASSWORD@194.164.245.107:5419/ebay_filtering

# Прокси — свой на каждого воркера (до прокси-сервиса), подставляются в compose.
